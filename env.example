# Telegram API credentials from https://my.telegram.org
API_ID=12345678
API_HASH=replace_me
BOT_TOKEN=123456789:replace_me
OWNER_ID=123456789

# Optional: comma-separated additional admin IDs
ADMIN_IDS=
BOT_USERNAME=your_bot_username
APP_NAME=Save Restricted Pro V2
TIMEZONE=Asia/Kolkata
PORT=8080

# Business payment settings
UPI_ID=yourupi@bank
UPI_NAME=Your Business Name
SUPPORT_USERNAME=your_support_username
UPDATES_CHANNEL=https://t.me/your_updates_channel
TERMS_URL=

# IMPORTANT: set a long random secret in production.
# You can generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=replace_with_fernet_key

# Scaling / safety
DB_PATH=bot_data.db
DATA_DIR=data
WORKER_COUNT=2
MAX_BATCH_SIZE=250
MAX_QUEUE_PER_USER=5
JOB_TIMEOUT_SECONDS=7200
FREE_DAILY_LIMIT=2
TRIAL_DAILY_LIMIT=50
RATE_LIMIT_MESSAGES=12
RATE_LIMIT_WINDOW=15
LOG_LEVEL=INFO
